PORT=3027
# Local defaults remain private; the container overrides HOST and data directory.
# HOST=127.0.0.1
# GOMOTION_DATA_DIR=/data
# APP_ORIGINS=https://gomotion-mvp.vercel.app,https://api.example.com
# Gemini is the current default for text, visual selection and audio review.
# One server-only GEMINI_API_KEY supplies all Gemini roles unless an explicit
# role key below overrides it. When rotating explicit role keys, update all of them.
# GEMINI_API_KEY=
# TEXT_AI_PROVIDER=vision
# Optional OpenAI-compatible scene planner; inactive with TEXT_AI_PROVIDER=vision.
# Existing SECRET_DEEPSEEK_API_KEY is detected only for this optional planner.
# LLM_API_KEY=
# LLM_BASE_URL=https://api.deepseek.com
# LLM_MODEL=deepseek-flash
# Optional stock providers. Wikimedia Commons and Internet Archive need no key.
# PEXELS_API_KEY=
# PIXABAY_API_KEY=
# COVERR_API_KEY=
# Optional: an HTTP(S) CONNECT proxy used by server-side requests.
# HTTPS_PROXY=http://127.0.0.1:7897

# Optional visual selection: native Gemini video or compatible image inputs.
# VISION_PROVIDER=gemini
# VISION_API_KEY=
# VISION_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# VISION_MODEL=gemini-3.8-flash

# Optional alternative: text planning and frame/image selection with DeepSeek:
# VISION_PROVIDER=openai
# VISION_BASE_URL=https://api.deepseek.com
# VISION_MODEL=deepseek-flash
# VISION_API_KEY=
# TEXT_AI_PROVIDER=vision
# Keep audio credentials separate when the primary service cannot read audio.
# NARRATION_API_KEY=
# NARRATION_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# TTS_MODEL=gemini-2.5-flash-preview-tts
# Preview and film narration share this model setting. Paid tier is determined
# by the Google project's billing status, not by changing the API URL or model.
# REVIEW_PROVIDER=gemini
# REVIEW_API_KEY=
# REVIEW_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# REVIEW_MODEL=gemini-3.8-flash
# The review role reads both final-film audio/video and narration timing audio.
# No credentials are embedded in the reusable cloud snapshot or browser bundle.

# Optional YouTube metadata/reference search; does not deliver source MP4 files.
# YOUTUBE_API_KEY=
# Optional readable font directory for burned subtitles on non-macOS systems.
# CAPTION_FONTS_DIR=
# Optional source-image motion graphics font on Linux.
# MOTION_FONT_FILE=/usr/share/fonts/opentype/noto/NotoSansCJK-Regular.ttc
# MOTION_FONT_FAMILY=Noto Sans CJK SC
