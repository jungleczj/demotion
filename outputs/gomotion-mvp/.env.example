PORT=3027
# Local defaults remain private; the container overrides HOST and data directory.
# HOST=127.0.0.1
# GOMOTION_DATA_DIR=/data
# APP_ORIGINS=https://gomotion-mvp.vercel.app,https://api.example.com
# Existing SECRET_DEEPSEEK_API_KEY is detected automatically.
# Optional OpenAI-compatible scene planner. Keys remain on the local server.
# LLM_API_KEY=
# LLM_BASE_URL=https://api.deepseek.com
# LLM_MODEL=deepseek-chat
# Optional stock providers. Wikimedia Commons and Internet Archive need no key.
# PEXELS_API_KEY=
# PIXABAY_API_KEY=
# COVERR_API_KEY=
# Optional: an HTTP(S) CONNECT proxy used by server-side requests.
# HTTPS_PROXY=http://127.0.0.1:7897

# Optional visual selection: native Gemini video or compatible image inputs.
# VISION_PROVIDER=gemini
# VISION_API_KEY=
# VISION_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# VISION_MODEL=gemini-3.8-flash

# Optional YouTube metadata/reference search; does not deliver source MP4 files.
# YOUTUBE_API_KEY=
# Optional readable font directory for burned subtitles on non-macOS systems.
# CAPTION_FONTS_DIR=
# Optional source-image motion graphics font on Linux.
# MOTION_FONT_FILE=/usr/share/fonts/opentype/noto/NotoSansCJK-Regular.ttc
# MOTION_FONT_FAMILY=Noto Sans CJK SC
